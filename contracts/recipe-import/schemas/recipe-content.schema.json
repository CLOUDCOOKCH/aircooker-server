{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mealf:schema:recipe-content:v1",
  "title": "MealF Recipe Content v1",
  "description": "Provider-neutral content shared by manual entry, website import and AI extraction. Null means unknown; zero means explicitly zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "description",
    "language",
    "servings",
    "yield",
    "times",
    "ingredients",
    "instructions",
    "category",
    "cuisine",
    "tags",
    "notes"
  ],
  "properties": {
    "title": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 language tag such as de-CH, en-US."
    },
    "servings": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "yield": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantity",
            "unit",
            "rawText"
          ],
          "properties": {
            "quantity": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "rawText": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      ]
    },
    "times": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepMinutes",
        "cookMinutes",
        "totalMinutes"
      ],
      "properties": {
        "prepMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cookMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "totalMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "quantity",
          "preparation",
          "notes",
          "optional",
          "group",
          "originalText"
        ],
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "quantity": {
            "type": "object",
            "additionalProperties": false,
            "description": "Parsed amount. Do not convert volume to mass without an ingredient-specific conversion.",
            "required": [
              "value",
              "maxValue",
              "unit",
              "rawText"
            ],
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "maxValue": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "rawText": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            }
          },
          "preparation": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "optional": {
            "type": "boolean"
          },
          "group": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "originalText": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "group",
          "durationMinutes",
          "temperature"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "durationMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "temperature": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "unit"
                ],
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "enum": [
                      "C",
                      "F"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "category": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "cuisine": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
