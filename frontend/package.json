{
  "name": "mealf-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/theme-assets.mjs && vite --host 0.0.0.0",
    "api:generate": "openapi-typescript ../contracts/openapi-v1.json -o src/api-schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/theme-assets.mjs && vite build && node scripts/attributions.mjs && node scripts/build-worker.mjs",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "format:check": "prettier --check src scripts public/push-handler.js public/peach.js public/peach.css public/appearance.js index.html licenses vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "idb": "8.0.4",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "fake-indexeddb": "6.2.6",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
